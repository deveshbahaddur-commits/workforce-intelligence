# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=
PORT=8787
AUDIT_DB_PATH=./data/audit.sqlite
KPI_DB_PATH=./data/kpi.sqlite
CHAT_DB_PATH=./data/chat.sqlite
AUTH_DB_PATH=./data/auth.sqlite

# Master employee data source (Google Sheet, shared as "Anyone with the link" viewer).
# Sheet ID is the long string in the sheet's URL between /d/ and /edit.
HRIS_SHEET_ID=
HRIS_SHEET_GID=0
HRIS_SHEET_CACHE_TTL_MS=300000

# Any long random string — used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# After the server is running, provision each manager's password with:
# npm run set-password -- someone@recykal.com "TempPassword123"

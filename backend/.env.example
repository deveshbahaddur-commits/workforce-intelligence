# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=
PORT=8787

# The code falls back to a local file (./data/app.db) if these are unset,
# but that path needs a native binary that doesn't load on every Windows
# setup — a free Turso database (turso.tech, no card needed) sidesteps
# that and matches production exactly. Same two values go in the Render
# dashboard for production (not committed there either).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Master employee data source (Google Sheet, shared as "Anyone with the link" viewer).
# Sheet ID is the long string in the sheet's URL between /d/ and /edit.
HRIS_SHEET_ID=
HRIS_SHEET_GID=0
HRIS_SHEET_CACHE_TTL_MS=300000

# Any long random string — used to sign session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# After the server is running, provision each manager's password with:
# npm run set-password -- someone@recykal.com "TempPassword123"

# Comma-separated Official Mail IDs that get admin access (org-wide KPI
# visibility, org goals drafting, alignment checks, building anyone's KPIs).
ADMIN_EMAILS=
